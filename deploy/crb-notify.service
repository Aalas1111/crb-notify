[Unit]
Description=crb-notify 接收入口（浏览器插件投递申请记录 → 判定 → 出通知）
Documentation=file:/opt/crb-notify/docs/intake-contract.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yuque
Group=yuque
WorkingDirectory=/opt/crb-notify

# 复用 yuque-agent 那份环境（YQA_REPO 在里面）；本项目自己的配置与密钥
# 都在它自己的文件里 —— **包括 CRBA_WORKSPACE / CRBA_YQA_BIN**。
# 那些值曾经写成本单元的 `Environment=`，结果只有服务拿得到：手工跑 CLI
# （show / forget / deliver）时缺值，`CRBA_YQA_BIN` 回落到机器上没有的 `yqa`，
# 于是语雀那篇静默不重生。配置只放一处，单元不要重复设。
EnvironmentFile=/home/yuque/.yuque/agent.env
EnvironmentFile=-/home/yuque/.crb-notify/env

Environment=HOME=/home/yuque
Environment=PYTHONUNBUFFERED=1
Environment=UV_CACHE_DIR=/var/lib/crb-notify/.uv-cache
Environment=PATH=/home/yuque/.local/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/usr/local/bin/uv run --no-sync crb-notify serve

Restart=always
RestartSec=15
SuccessExitStatus=143

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 要写自己的 workspace；**还要写 yqa 的 outbox/notify/pending/**（QQ 通知取件处）。
ReadWritePaths=/var/lib/crb-notify /var/lib/yuque-agent/workspace
ReadOnlyPaths=-/home/yuque/.yuque

[Install]
WantedBy=multi-user.target
